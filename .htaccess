# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

Options -Indexes
DirectoryIndex index.php

# O projeto pode ser hospedado com a raiz do repositório como document root.
# Bloqueie código-fonte, configurações, backups e arquivos de dados nesse caso.
<FilesMatch "^(?:\.env(?:\..*)?|.*\.(?:sql|log|bak|backup|old|orig|ini|cnf))$">
  Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule ^(?:app|config|database|storage|tests|scripts|vendor|\.git)(?:/|$) - [F,L]

# Se existir arquivo ou pasta, não mexe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redireciona tudo pro index.php (Slim)
RewriteRule ^ index.php [QSA,L]
